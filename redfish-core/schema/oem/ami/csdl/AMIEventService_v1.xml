<?xml version="1.0" encoding="UTF-8"?>
<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">

  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Measures.V1.xml">
    <edmx:Include Namespace="Org.OData.Measures.V1" Alias="Measures"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
    <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
    <edmx:Include Namespace="Resource"/>
    <edmx:Include Namespace="Resource.v1_0_0"/>
  </edmx:Reference>

  <edmx:DataServices>
  
  <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="AMIEventService">
      <ComplexType Name="Oem" BaseType="Resource.OemObject">
        <Annotation Term="OData.AdditionalProperties" Bool="true" />
        <Annotation Term="OData.Description" String="AMIEventService Oem properties." />
        <Annotation Term="OData.AutoExpand"/>
        <Property Name="OpenBmc" Type="AMIEventService.OpenBmc"/>
     </ComplexType>
   
     <ComplexType Name="OpenBmc" BaseType="Resource.OemObject">
        <Annotation Term="OData.AdditionalProperties" Bool="true" />
        <Annotation Term="OData.Description" String="Oem properties for OpenBmc." />
        <Annotation Term="OData.AutoExpand"/>
        <Property Name="SMTP" Type="AMIEventService.SMTP"/>
      </ComplexType>
     
     <ComplexType Name="SMTP" BaseType="Resource.OemObject">
        <Annotation Term="OData.AdditionalProperties" Bool="true" />
        <Annotation Term="OData.Description" String="OpenBmc oem smtp properties." />
        <Annotation Term="OData.AutoExpand"/>
        <Property Name="PrimaryConfiguration" Type="AMIEventService.Configuration"/>
        <Property Name="SecondaryConfiguration" Type="AMIEventService.Configuration"/>
     </ComplexType>

      <ComplexType Name="Configuration" BaseType="Resource.OemObject">
        <Annotation Term="OData.AdditionalProperties" Bool="false" />
        <Annotation Term="OData.Description" String="An indication by boolean value." />
	<Property Name="Authentication" Type="Edm.Boolean">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates Authentication of the user"/>
	   <Annotation Term="OData.LongDescription" String="The value of this property is used to indicate Authentication of a user"/>
        </Property>
        <Property Name="Enable" Type="Edm.Boolean">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates to Enable SMTP"/>
	   <Annotation Term="OData.LongDescription" String="The value of this property is used to enable SMTP otherwise mail won’t go."/>            
        </Property>
        <Property Name="Host" Type="Edm.String">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates SMTP server Ip address"/>
	   <Annotation Term="OData.LongDescription" String="The value of this property is used to indicate SMTP server Ip address."/>            
        </Property>
        <Property Name="Password" Type="Edm.String">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates Password of SMTP server"/>
	   <Annotation Term="OData.LongDescription" String="The value of this property is SMTP server password required when authentication."/>          
       </Property>
        <Property Name="Port" Type="Edm.Decimal">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates SMTP server Port"/>
	   <Annotation Term="OData.LongDescription" String="The value of this property indicates SMTP server Port."/>    
        </Property>
        <Property Name="Recipient" Type="Collection(Edm.String)">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates Receiver email address."/>
	   <Annotation Term="OData.LongDescription" String="The value of this property indicates Receiver email address."/>        
        </Property>
        <Property Name="Sender" Type="Edm.String">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="Email address of a receiver sent to."/>
	   <Annotation Term="OData.LongDescription" String="Email address of a receiver sent to."/> 
        </Property>
        <Property Name="TLSEnable" Type="Edm.Boolean">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates to Start TLS Encryption."/>
	   <Annotation Term="OData.LongDescription" String="The value of this property indicate to Start TLS Encryption."/>                </Property>
        <Property Name="UserName" Type="Edm.String">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="SMTP server username required when authentication."/>
	   <Annotation Term="OData.LongDescription" String="SMTP server username required when authentication."/>
        </Property>
        <Property Name="isCACERTExist" Type="Edm.Boolean">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates CACERT exist or not"/>
	   <Annotation Term="OData.LongDescription" String="The value of this property is used to indicate CA certificate exist or not "/>         
        </Property>
        <Property Name="isServerCRTExist" Type="Edm.Boolean">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates ServerCRT Exist or not"/>
	   <Annotation Term="OData.LongDescription" String="The value of this property indicates wether server certificate exist or not."/> 
        </Property>
        <Property Name="isServerKeyExist" Type="Edm.Boolean">
           <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
           <Annotation Term="OData.Description" String="This indicates Server Key exist or not"/>
	   <Annotation Term="OData.LongDescription" String="The value of this property is used to indicate Server Key exist or not."/> 
        </Property>
      </ComplexType>

        </Schema>
    </edmx:DataServices>
</edmx:Edmx>

