<?xml version="1.0" encoding="UTF-8"?>
<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">

   <edmx:Reference
      Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
      <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData" />
   </edmx:Reference>
   <edmx:Reference
      Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Measures.V1.xml">
      <edmx:Include Namespace="Org.OData.Measures.V1" Alias="Measures" />
   </edmx:Reference>
   <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
      <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish" />
   </edmx:Reference>
   <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
      <edmx:Include Namespace="Resource" />
      <edmx:Include Namespace="Resource.v1_0_0" />
   </edmx:Reference>

   <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="AMISyslog">
	 <EntityType Name="AMISyslog" Bool="false">     
	    <Annotation Term="OData.Description" String="This is the schema definition for the OEM section under LogService Syslog URI."/>
	    <Annotation Term="OData.LongDescription" String="This resource shall be used to represent the OEM attributes available under LogService Syslog URI."/>
	    <Annotation Term="Capabilities.InsertRestrictions">
	      <Record>
	         <PropertyValue Property="Insertable" Bool="true"/>
	      </Record>
	    </Annotation>
	    <Annotation Term="Capabilities.UpdateRestrictions">
	      <Record>
		<PropertyValue Property="Updatable" Bool="true"/>
	      </Record>
	    </Annotation>
	    <Annotation Term="Capabilities.DeleteRestrictions">
	      <Record>
		<PropertyValue Property="Deletable" Bool="false"/>
	      </Record>
	    </Annotation>
         </EntityType>
       </Schema>

      <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="AMISyslog.v1_0_0">
         <Action Name="Configuration" IsBound="true">
            <Annotation Term="OData.Description"
               String="This action sends Syslog alerts from Log Service." />
            <Annotation Term="OData.LongDescription"
               String="This action shall sends Syslog alerts from Log Service." />
            <Annotation Term="Redfish.Revisions">
               <Collection>
                  <Record>
                     <PropertyValue Property="Kind" EnumMember="Redfish.RevisionKind/Added" />
                     <PropertyValue Property="Version" String="v1_0_0" />
                  </Record>
               </Collection>
            </Annotation>
         </Action>
         <ComplexType Name="Oem" BaseType="Resource.OemObject">
            <Annotation Term="OData.AdditionalProperties" Bool="true" />
            <Annotation Term="OData.Description" String="AMISyslog Oem properties." />
            <Annotation Term="OData.AutoExpand" />
            <Property Name="Ami" Type="AMISyslog.v1_0_0.Ami" />
         </ComplexType>

         <ComplexType Name="Ami" BaseType="Resource.OemObject">
            <Annotation Term="OData.AdditionalProperties" Bool="true" />
            <Annotation Term="OData.Description" String="Oem properties for Ami." />
            <Annotation Term="OData.AutoExpand" />
            <Property Name="SysLog" Type="AMISyslog.v1_0_0.SysLog" />
         </ComplexType>

         <ComplexType Name="SysLog" BaseType="Resource.OemObject">
            <Annotation Term="OData.AdditionalProperties" Bool="true" />
            <Annotation Term="OData.Description" String="OpenBmc oem Syslog properties." />
            <Annotation Term="OData.AutoExpand" />
            <Property Name="Configuration" Type="AMISyslog.v1_0_0.Configuration" />
         </ComplexType>

         <ComplexType Name="Configuration" BaseType="Resource.OemObject">
            <Annotation Term="OData.AdditionalProperties" Bool="false" />
            <Annotation Term="OData.Description" String="An indication by boolean value." />
            <Property Name="Authentication" Type="Edm.Boolean">
               <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite" />
               <Annotation Term="OData.Description"
                  String="This indicates Authentication of the user" />
               <Annotation Term="OData.LongDescription"
                  String="The value of this property is used to indicate Authentication of a user" />
            </Property>
            <Property Name="FileSize" Type="Edm.Int16" Nullable="false">
				<Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
				<Annotation Term="OData.Description" String="The size of the file in bytes."/>
				<Annotation Term="OData.LongDescription" String="The value of this property shall specify the size of the Rsyslog file."/>
			</Property>
			<Property Name="RemoteServerPort" Type="Edm.Int16" Nullable="false">
				<Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
				<Annotation Term="OData.Description" String="The port number used for communication."/>
				<Annotation Term="OData.LongDescription" String="The value of this property shall specify the port number used for communication."/>
			</Property>
			<Property Name="RotateCount" Type="Edm.Boolean" Nullable="false">
				<Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
				<Annotation Term="OData.Description" String="Indicates whether log rotation is enabled."/>
				<Annotation Term="OData.LongDescription" String="The value of this property shall specify whether log rotation is enabled for Rsyslog."/>
			</Property>
			<Property Name="RemoteLogServer" Type="Edm.String" Nullable="false">
				<Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
				<Annotation Term="OData.Description" String="The server address used for communication."/>
				<Annotation Term="OData.LongDescription" String="The value of this property shall specify the server address used for communication."/>
			</Property>
			<Property Name="PortType" Type="Edm.String" Nullable="false">
				<Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
				<Annotation Term="OData.Description" String="The transport protocol used for communication."/>
				<Annotation Term="OData.LongDescription" String="The value of this property shall specify the transport protocol used for communication."/>
			</Property>
            <Property Name="isCACERTExist" Type="Edm.Boolean">
               <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite" />
               <Annotation Term="OData.Description" String="This indicates CACERT exist or not" />
               <Annotation Term="OData.LongDescription"
                  String="The value of this property is used to indicate CA certificate exist or not " />
            </Property>
            <Property Name="isServerCRTExist" Type="Edm.Boolean">
               <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite" />
               <Annotation Term="OData.Description" String="This indicates ServerCRT Exist or not" />
               <Annotation Term="OData.LongDescription"
                  String="The value of this property indicates wether server certificate exist or not." />
            </Property>
            <Property Name="isServerKeyExist" Type="Edm.Boolean">
               <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite" />
               <Annotation Term="OData.Description" String="This indicates Server Key exist or not" />
               <Annotation Term="OData.LongDescription"
                  String="The value of this property is used to indicate Server Key exist or not." />
            </Property>
            <Property Name="Actions" Type="AMISyslog.v1_0_0.Actions" Nullable="false">
               <Annotation Term="OData.Description" String="The available actions for this resource."/>
               <Annotation Term="OData.LongDescription" String="This property shall contain the available actions for this resource."/>
             </Property>  
         </ComplexType>
         <ComplexType Name="Actions">
            <Annotation Term="OData.AdditionalProperties" Bool="true"/>
            <Annotation Term="OData.Description" String="The available actions for this resource."/>
            <Annotation Term="OData.LongDescription" String="This type shall contain the available actions for this resource."/>
            <Property Name="Oem" Type="AMISyslog.v1_0_0.OemActions" Nullable="false">
              <Annotation Term="OData.Description" String="The available OEM-specific actions for this resource."/>
              <Annotation Term="OData.LongDescription" String="This property shall contain the available OEM-specific actions for this resource."/>
            </Property>
          </ComplexType>
          <ComplexType Name="OemActions">
            <Annotation Term="OData.AdditionalProperties" Bool="true"/>
            <Annotation Term="OData.Description" String="The available OEM-specific actions for this resource."/>
            <Annotation Term="OData.LongDescription" String="This type shall contain the available OEM-specific actions for this resource."/>
          </ComplexType>
      </Schema>
   </edmx:DataServices>
</edmx:Edmx>
