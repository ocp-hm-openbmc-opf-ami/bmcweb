    <edmx:DataServices>
      <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="AmiVirtualMedia">
            <Annotation Term="Redfish.OwningEntity" String="Ami" />
        <Action Name="LocalMediaRedirect" IsBound="true">
          <Annotation Term="OData.Description" String="This action redirects local virtual media to the system."/>
          <Annotation Term="OData.LongDescription" String="This action shall initiate a local virtual media redirection session for the system.
                              The service may require parameters such as image path or device type to complete the redirect."/>
          <Parameter Name="DataType" Type="Edm.String" Nullable="false">
            <Annotation Term="OData.Description" String="The URI of the DataType to be redirected."/>
            <Annotation Term="OData.LongDescription" String="This parameter shall contain the URI of the ISO or IMG file to be mounted as virtual media."/>
          </Parameter>
 
          <Parameter Name="Name" Type="Edm.String" Nullable="false">
            <Annotation Term="OData.Description"
                        String="The type of virtual media device (CD, DVD, Floppy, USB)."/>
            <Annotation Term="OData.LongDescription"
                        String="This parameter shall specify the type of virtual media device for redirection."/>
          </Parameter>
          <Parameter Name="Required" Type="Edm.String" Nullable="false">
            <Annotation Term="OData.Description"
                        String="The type of virtual media device (CD, DVD, Floppy, USB)."/>
            <Annotation Term="OData.LongDescription"
                        String="This parameter shall specify the type of virtual media device for redirection."/>
          </Parameter>
        </Action>
        <Action Name="LocalMediaStopRedirect" IsBound="true">
          <Annotation Term="OData.Description"
                      String="This action stops an ongoing local virtual media redirection session."/>
          <Annotation Term="OData.LongDescription"
                      String="This action shall terminate the local virtual media redirection session for the system.
                              After invocation, the redirected image or device will no longer be accessible to the system."/>
        </Action>
        <Action Name="LocalMediaUpload" IsBound="true">
          <Annotation Term="OData.Description"
                      String="This action uploads a local image for virtual media redirection."/>
          <Annotation Term="OData.LongDescription"
                      String="This action shall upload an image (such as ISO or IMG) to the service for use as virtual media.
                              The uploaded image can then be redirected to the system as a virtual device."/>
          <Parameter Name="DataType" Type="Edm.String" Nullable="false">
            <Annotation Term="OData.Description" String="The URI of the DataType to be redirected."/>
            <Annotation Term="OData.LongDescription" String="This parameter shall contain the URI of the ISO or IMG file to be mounted as virtual media."/>
          </Parameter>
 
          <Parameter Name="Name" Type="Edm.String" Nullable="false">
            <Annotation Term="OData.Description"
                        String="The type of virtual media device (CD, DVD, Floppy, USB)."/>
            <Annotation Term="OData.LongDescription"
                        String="This parameter shall specify the type of virtual media device for redirection."/>
          </Parameter>
          <Parameter Name="Required" Type="Edm.String" Nullable="false">
            <Annotation Term="OData.Description"
                        String="The type of virtual media device (CD, DVD, Floppy, USB)."/>
            <Annotation Term="OData.LongDescription"
                        String="This parameter shall specify the type of virtual media device for redirection."/>
          </Parameter>
        </Action>
      </Schema>
      <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="AmiVirtualMedia.v1_0_0">
            <Annotation Term="Redfish.OwningEntity" String="Ami" />
