            <ComplexType Name="AmiVirtualMedia">
                <Property Name="BackupImageURL" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
                    <Annotation Term="OData.Description" String="Indicates backup image URL for virtual media."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall contain the URL for the backup image used by virtual media."/>
                </Property>
 
                <Property Name="RetryCount" Type="Edm.Decimal" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
                    <Annotation Term="OData.Description" String="Indicates RetryCount for Rmedia Reconnect."/>
                    <Annotation Term="OData.LongDescription" String="The value of the property range should be allowed between 3 to 6."/>
                </Property>
 
                <Property Name="RetryInterval" Type="Edm.Decimal" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
                    <Annotation Term="OData.Description" String="Indicates RetryInterval for Rmedia reconnect."/>
                    <Annotation Term="OData.LongDescription" String="The value of the property range should be allowed between 15 to 30."/>
                </Property>
            </ComplexType>    
      </Schema>
