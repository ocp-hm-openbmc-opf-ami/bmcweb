            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
            <Annotation Term="OData.Description" String="The delay between retries in seconds."/>
            <Annotation Term="OData.LongDescription" String="This property shall define the time interval in seconds between retry attempts."/>
            <Annotation Term="Validation.Minimum" Int="0"/>
            <Annotation Term="Validation.Maximum" Int="3600"/>
        </Property>
        <Property Name="PendingAlertsLimit" Type="Edm.Int64" Nullable="false" DefaultValue="0">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
            <Annotation Term="OData.Description" String="The maximum number of alerts that can be queued."/>
            <Annotation Term="OData.LongDescription" String="This property shall contain the maximum number of alerts that can be processed as pending tasks."/>
