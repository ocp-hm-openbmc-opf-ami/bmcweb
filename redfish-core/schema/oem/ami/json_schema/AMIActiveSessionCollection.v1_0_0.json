{
    "$id": "http://redfish.dmtf.org/schemas/v1/AMIActiveSessionCollection.v1_0_0.json",
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema-v1.json",
    "definitions": {
        "AMIActiveSessionCollection": {
            "additionalProperties": false,
            "description": "Collection of active session references grouped by protocol.",
            "longDescription": "Represents currently active sessions on the BMC, categorized by access protocol.",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message)\\.[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "description": "This property shall specify a valid odata or Redfish property.",
                    "type": [
                        "array",
                        "boolean",
                        "integer",
                        "number",
                        "null",
                        "object",
                        "string"
                    ]
                }
            },
            "properties": {
                "KVM": {
                    "description": "Active KVM session references.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/definitions/SessionReference"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "type": "array"
                },
                "Members": {
                    "description": "List of session reference objects.",
                    "items": {
                        "$ref": "#/definitions/SessionReference"
                    },
                    "longDescription": "Each entry is a reference object containing @odata.id of an active session.",
                    "type": "array"
                },
                "Members@odata.count": {
                    "description": "Count of Members in this collection.",
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "Name": {
                    "description": "Friendly name of this active session collection.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "REDFISH": {
                    "description": "Active Redfish session references.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/definitions/SessionReference"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "type": "array"
                },
                "SSH": {
                    "description": "Active SSH session references.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/definitions/SessionReference"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "type": "array"
                },
                "VMEDIA": {
                    "description": "Active virtual media session references.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/definitions/SessionReference"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "type": "array"
                },
                "WEB": {
                    "description": "Active HTTPS (web) session references.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/definitions/SessionReference"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "SessionReference": {
            "additionalProperties": false,
            "description": "Reference to an active session resource.",
            "longDescription": "Contains the @odata.id of an active session resource.",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message)\\.[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "description": "This property shall specify a valid odata or Redfish property.",
                    "type": [
                        "array",
                        "boolean",
                        "integer",
                        "number",
                        "null",
                        "object",
                        "string"
                    ]
                }
            },
            "properties": {
                "@odata.id": {
                    "description": "OData ID of the referenced session.",
                    "type": "string"
                }
            },
            "type": "object"
        }
    },
    "owningEntity": "Ami",
    "release": "1.0",
    "title": "#AMIActiveSessionCollection.v1_0_0"
}
