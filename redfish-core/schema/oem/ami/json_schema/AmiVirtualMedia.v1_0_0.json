        "LocalMediaRedirect": {
            "additionalProperties": false,
            "description": "This action redirects local virtual media to the system.",
            "longDescription": "This action shall initiate a local virtual media redirection session for the system.                                The service may require parameters such as image path or device type to complete the redirect.",
