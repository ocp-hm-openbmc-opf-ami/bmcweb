<?xml version="1.0" encoding="UTF-8"?>
<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">

  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Measures.V1.xml">
    <edmx:Include Namespace="Org.OData.Measures.V1" Alias="Measures"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
    <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
    <edmx:Include Namespace="Resource"/>
    <edmx:Include Namespace="Resource.v1_0_0"/>
  </edmx:Reference>

  <edmx:Reference Uri="/redfish/v1/Schemas/MeterStateFeature_v1.xml">
    <edmx:Include Namespace="MeterStateFeature"/>
  </edmx:Reference>

  <edmx:Reference Uri="/redfish/v1/Schemas/ProvisionDynamicFeature_v1.xml">
    <edmx:Include Namespace="ProvisionDynamicFeature"/>
  </edmx:Reference>

  <edmx:DataServices>

    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="OemProcessor">
      <Annotation Term="Redfish.OwningEntity" String="Intel"/>
    </Schema>

    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="OemProcessor.v1_0_0">
      <Annotation Term="Redfish.OwningEntity" String="Intel"/>
      <Annotation Term="Redfish.Release" String="1.0"/>

        <NavigationProperty Name="MeteringFeature" Type="MeterStateFeature.MeterStateFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the Metering Feature."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to SSI Metering Feature ."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
        <NavigationProperty Name="UnsignedMeteringFeature" Type="MeterStateFeature.MeterStateFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the Unsigned Metering Feature."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to SSI Unsigned Metering Feature ."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
        <NavigationProperty Name="StateFeature" Type="MeterStateFeature.MeterStateFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the State Service."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to OnDemand State Feature."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
		<NavigationProperty Name="ProvisionFeature" Type="ProvisionDynamicFeature.ProvisionDynamicFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the Provision Feature."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to OnDemand Provision Feature ."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
		<NavigationProperty Name="DynamicFeature" Type="ProvisionDynamicFeature.ProvisionDynamicFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the Dynamic Feature."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to OnDemand Dynamic Feature ."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>

      <EntityContainer Name="ServiceContainer" Extends="ServiceRoot.v1_0_0.ServiceContainer"> 
	      <Singleton Name="MeteringFeature" Type="MeterStateFeature.MeterStateFeature"/>
	      <Singleton Name="StateFeature" Type="MeterStateFeature.MeterStateFeature"/>
		  <Singleton Name="ProvisionFeature" Type="ProvisionDynamicFeature.ProvisionDynamicFeature"/>
	      <Singleton Name="DynamicFeature" Type="ProvisionDynamicFeature.ProvisionDynamicFeature"/>
      </EntityContainer>

      <ComplexType Name="Processor" BaseType="Resource.OemObject" Abstract="true">
        <Annotation Term="OData.Description" String="OEM Extension for Processor"/>
        <Annotation Term="OData.LongDescription" String="OEM Extension for Processor to support oem services."/>
        <NavigationProperty Name="MeteringFeature" Type="MeterStateFeature.MeterStateFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the Metering Feature."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to Metering Feature ."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
        <NavigationProperty Name="StateFeature" Type="MeterStateFeature.MeterStateFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the Nm Service."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to a Resource of type NmService."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
		<NavigationProperty Name="ProvisionFeature" Type="ProvisionDynamicFeature.ProvisionDynamicFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the Provision Feature."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to Provision Feature ."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
		<NavigationProperty Name="DynamicFeature" Type="ProvisionDynamicFeature.ProvisionDynamicFeature" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The link to the Dynamic Feature."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain a link to Dynamic Feature ."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
      </ComplexType>
    </Schema>

  </edmx:DataServices>
</edmx:Edmx>
