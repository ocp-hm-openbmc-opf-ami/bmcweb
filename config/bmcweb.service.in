[Unit]
Description=Start bmcwebd server

Requires=bmcweb.socket
After=bmcweb.socket

Wants=network.target
After=network.target

[Service]
Restart=always
ExecReload=kill -s HUP $MAINPID
ExecStart=@MESON_INSTALL_PREFIX@/libexec/bmcwebd
ExecStop=/bin/bash -c '/usr/bin/test -x /usr/bin/delete-hi-user.sh && /bin/bash /usr/bin/delete-hi-user.sh || true'
Type=simple
WorkingDirectory=/home/root

[Install]
WantedBy=network.target
